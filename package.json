{
  "name": "@misarmail/mcp",
  "version": "5.1.1",
  "mcpName": "io.github.Misar-AI/misarmail-mcp",
  "description": "MisarMail MCP server — send email, run campaigns, manage contacts and automations, A/B test, and audit deliverability from Claude, Cursor, VS Code, Windsurf, and any MCP client.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    }
  },
  "bin": {
    "misarmail-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "smithery.yaml",
    "server.json",
    "README.md",
    "skills",
    "prompts",
    "connectors"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "email",
    "email-marketing",
    "email-api",
    "transactional-email",
    "campaigns",
    "newsletter",
    "contacts",
    "crm",
    "automation",
    "drip-campaign",
    "ab-testing",
    "deliverability",
    "dmarc",
    "spf",
    "dkim",
    "inbox",
    "smtp",
    "analytics",
    "claude",
    "claude-code",
    "cursor",
    "windsurf",
    "vscode",
    "ai-agent",
    "misarmail"
  ],
  "homepage": "https://www.misarmail.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Misar-AI/misarmail-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Misar-AI/misarmail-mcp/issues"
  },
  "author": "Misar AI <support@misar.io>",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18"
  }
}
