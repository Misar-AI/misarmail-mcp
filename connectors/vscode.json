{
  "inputs": [
    {
      "type": "promptString",
      "id": "misarmail-key",
      "description": "MisarMail API key (msk_…) — create one at https://mail.misar.io/developers",
      "password": true
    }
  ],
  "servers": {
    "misarmail": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@misarmail/mcp@latest"
      ],
      "env": {
        "MISARMAIL_API_KEY": "${input:misarmail-key}"
      }
    }
  }
}
